PORT=3001

# OpenAI — required for POST /api/admin/submissions/:id/score
OPENAI_API_KEY=sk-your-openai-key

# Airtable — required for all data persistence
# Create a Personal Access Token at https://airtable.com/create/tokens
# with data.records:read and data.records:write scopes on the base below.
AIRTABLE_API_KEY=pat_your_api_key
AIRTABLE_BASE_ID=app_your_base_id
AIRTABLE_TABLE_NAME=SPEAKER_SUBMISSIONS

# Demo-grade shared-secret gate for /api/admin/* routes (checked via the
# x-admin-key request header). Not per-admin auth — just enough to keep the
# admin API from being wide open during the hackathon.
ADMIN_API_KEY=choose-a-random-string

# Optional — email provider. Leave blank to use the console-log fallback.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Used to build the self-service link in emails, and as the CORS-allowed origin.
FRONTEND_URL=http://localhost:3000
