# SpeakerFlow environment template
# Copy values into backend/.env and frontend/.env.local as appropriate.

# Backend: Airtable datastore
AIRTABLE_API_KEY=pat_your_airtable_token
AIRTABLE_BASE_ID=app_your_airtable_base_id
AIRTABLE_TABLE_NAME=SPEAKER_SUBMISSIONS

# Backend: admin and service integrations
ADMIN_API_KEY=change-me
OPENAI_API_KEY=sk-your-openai-key
RESEND_API_KEY=re_your_resend_key
RESEND_FROM_EMAIL=onboarding@resend.dev
FRONTEND_URL=http://localhost:3000

# Frontend: browser-visible API base
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
